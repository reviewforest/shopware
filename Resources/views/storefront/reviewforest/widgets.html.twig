{#
    Widget IDs are UUIDs from the ReviewForest embed code. Anything else is ignored, so a typo in the
    configuration can never inject markup. The footer widget is rendered by layout/footer/footer.html.twig.
#}
{% set rfWidgetIds = [] %}
{% if config('ReviewForest.config.widgetsEnabled') is not same as(false) %}
    {% set rfCandidates = [config('ReviewForest.config.floatingWidgetId')|default('')]|merge(config('ReviewForest.config.additionalWidgetIds')|default('')|split(',')) %}
    {% for rfCandidate in rfCandidates %}
        {% set rfId = rfCandidate|trim %}
        {% if rfId matches '/^[A-Za-z0-9-]{8,64}$/' and rfId not in rfWidgetIds %}
            {% set rfWidgetIds = rfWidgetIds|merge([rfId]) %}
        {% endif %}
    {% endfor %}
    {% set rfFooterWidgetId = config('ReviewForest.config.footerWidgetId')|default('')|trim %}
    {% set rfHasFooter = rfFooterWidgetId matches '/^[A-Za-z0-9-]{8,64}$/' %}
    {% if rfWidgetIds is not empty or rfHasFooter %}
        {% for rfId in rfWidgetIds %}
            <div class="reviewforest-app-{{ rfId }}"></div>
        {% endfor %}
        <script src="https://widgets.reviewforest.org/main.js" defer></script>
    {% endif %}
{% endif %}
