{#
    Widget IDs are UUIDs from the ReviewForest embed code. Merchants may paste the whole embed code instead of
    the ID: the part after "reviewforest-app-" is taken. Anything that is not a plain ID after that is ignored,
    so a typo in the configuration can never inject markup. The footer widget is rendered by
    layout/footer/footer.html.twig.
#}
{% set rfWidgetIds = [] %}
{# No third-party widget script on checkout and account pages unless the merchant enables it; the cart counts as a shop page. #}
{% set rfRoute = app.request.attributes.get('_route')|default('') %}
{% set rfSensitivePage = (rfRoute starts with 'frontend.checkout.' and rfRoute != 'frontend.checkout.cart.page') or rfRoute starts with 'frontend.account.' %}
{# Switches are compared exactly: a value set as text on the command line ("false") must not count as on. #}
{% set rfOnSensitive = config('ReviewForest.config.widgetsOnCheckoutAndAccount') %}
{% set rfWidgetsSetting = config('ReviewForest.config.widgetsEnabled') %}
{% set rfWidgetPageAllowed = not rfSensitivePage or (rfOnSensitive is same as(true) or rfOnSensitive is same as('true') or rfOnSensitive is same as('1')) %}
{% if not (rfWidgetsSetting is same as(false) or rfWidgetsSetting is same as('false') or rfWidgetsSetting is same as('0')) and rfWidgetPageAllowed %}
    {% set rfCandidates = [config('ReviewForest.config.floatingWidgetId')|default('')]|merge(config('ReviewForest.config.additionalWidgetIds')|default('')|split(',')) %}
    {% for rfCandidate in rfCandidates %}
        {% set rfId = rfCandidate|trim|split('reviewforest-app-')|last|split('"')|first|split("'")|first|split('>')|first|trim|split(' ')|first %}
        {% if rfId matches '/^[A-Za-z0-9-]{8,64}$/' and rfId not in rfWidgetIds %}
            {% set rfWidgetIds = rfWidgetIds|merge([rfId]) %}
        {% endif %}
    {% endfor %}
    {% set rfFooterWidgetId = config('ReviewForest.config.footerWidgetId')|default('')|trim|split('reviewforest-app-')|last|split('"')|first|split("'")|first|split('>')|first|trim|split(' ')|first %}
    {% set rfHasFooter = rfFooterWidgetId matches '/^[A-Za-z0-9-]{8,64}$/' %}
    {% if rfWidgetIds is not empty or rfHasFooter %}
        {% for rfId in rfWidgetIds %}
            <div class="reviewforest-app-{{ rfId }}"></div>
        {% endfor %}
        <script src="https://widgets.reviewforest.org/main.js" defer></script>
    {% endif %}
{% endif %}
