{#
    POST /storefront/script/reviewforest-consent
    Stores the buyer's answer to the review invitation question on the order (custom fields).

    Accepts form posts (finish page without JavaScript, answered with a redirect back to the finish page)
    and JSON posts from the app's storefront JavaScript (answered with JSON).
    Only the customer who placed the order (logged in or guest session) can answer, and only once.
#}
{% set rfOrderId = hook.request.orderId|default('') %}
{% set rfConsent = hook.request.consent|default('') %}
{% set rfSource = hook.request.source|default('') %}
{% set rfRedirect = hook.request.redirect|default('') == '1' %}
{% set rfCustomer = hook.salesChannelContext.customer %}

{% if rfOrderId is empty or rfOrderId|length != 32 or rfConsent not in ['yes', 'no'] or rfSource not in ['finish_dialog', 'checkout_checkbox'] %}
    {% do hook.setResponse(services.response.json({ 'success': false, 'error': 'invalid_request' }, 400)) %}
    {% return %}
{% endif %}

{% if rfCustomer is null %}
    {% do hook.setResponse(services.response.json({ 'success': false, 'error': 'not_logged_in' }, 403)) %}
    {% return %}
{% endif %}

{% set rfCriteria = {
    'ids': [rfOrderId],
    'filter': [
        { 'type': 'equals', 'field': 'orderCustomer.customerId', 'value': rfCustomer.id },
        { 'type': 'equals', 'field': 'salesChannelId', 'value': hook.salesChannelContext.salesChannelId }
    ]
} %}
{% set rfOrder = services.repository.search('order', rfCriteria).first %}

{% if rfOrder is null %}
    {% do hook.setResponse(services.response.json({ 'success': false, 'error': 'order_not_found' }, 404)) %}
    {% return %}
{% endif %}

{% set rfExisting = (rfOrder.customFields ?? {})['reviewforest_consent'] ?? null %}

{% if rfExisting is null %}
    {#
        The text shown to the buyer is derived here, on the server, from the buyer's language and the current
        settings, never taken from the request. Keep the version IDs in sync with consent-text.html.twig.
        A custom text can change later in the settings, so its exact wording is stored with the order.
    #}
    {% set rfLanguage = services.repository.search('language', { 'ids': [hook.salesChannelContext.languageId], 'associations': { 'locale': {} } }).first %}
    {% set rfDe = (rfLanguage.locale.code ?? 'de-DE')|lower starts with 'de' %}
    {% set rfCustom = (rfDe ? services.config.app('consentTextDe') : services.config.app('consentTextEn'))|default('')|trim %}
    {% if rfCustom is not empty %}
        {% set rfStoredText = (rfDe ? 'custom-de: ' : 'custom-en: ') ~ rfCustom %}
    {% else %}
        {% set rfStoredText = rfDe ? 'rf-de-2026-10-v1' : 'rf-en-2026-10-v1' %}
    {% endif %}
    {% do services.writer.upsert('order', [{
        'id': rfOrderId,
        'customFields': {
            'reviewforest_consent': rfConsent,
            'reviewforest_consent_at': 'now'|date('Y-m-d\\TH:i:sP', 'UTC'),
            'reviewforest_consent_source': rfSource,
            'reviewforest_consent_text': rfStoredText|slice(0, 2000)
        }
    }]) %}
{% endif %}

{% if rfRedirect %}
    {% do hook.setResponse(services.response.redirect('frontend.checkout.finish.page', { 'orderId': rfOrderId })) %}
{% else %}
    {% do hook.setResponse(services.response.json({ 'success': true, 'consent': rfExisting ?? rfConsent })) %}
{% endif %}
