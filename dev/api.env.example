# Local environment for the ReviewForest API when testing the Shopware app.
# Copy to apps/api/.env.shopware-dev in the backend worktree (never commit real keys).
# No SendGrid key: the API cannot send invitations locally; due invitations are retried. To see one go out,
# use a test SendGrid key or replace the client in a script (see the usability test notes).
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27019/rf_shopware_dev?replicaSet=rs0&directConnection=true
MONGODB_REPLICA=reviewforest-dev
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
APP_BASEURL=http://host.docker.internal:3000
FOREST_DOMAIN=http://localhost:3001
WEB_APP_URL=http://localhost:8080
SECRET_KEY=dev-secret-key
TRUST_PROXY=loopback,uniquelocal
STRIPE_API_SECRET_KEY=sk_test_dummy
IS_SCRAPER_ENABLED={}
MAKE_SCENARIO=false
SENDGRID_API_KEYS={}
SENDGRID_EMAIL_TEMPLATE_IDS={}
SENDGRID_ASM_GROUP_IDS={}
STRIPE_WEBHOOK_WORKER_DISABLED=true
APIFY_WEBHOOK_WORKER_DISABLED=true
GMB_CONNECTION_NOTIFICATION_WORKER_DISABLED=true
SMS_BATCH_WORKER_DISABLED=true
INVITATION_JOB_WORKER_POLLING_INTERVAL_MS=5000
ORDER_TREE_WORKER_INTERVAL_MS=5000
SHOPWARE_APP_SECRET=local-dev-app-secret
SHOPWARE_CREDENTIALS_KEY=local-dev-credentials-key
SHOPWARE_ALLOW_PRIVATE_URLS=true
# Duplicate protection of the invitations (local value only).
INVITATION_RECIPIENT_HASH_SECRET=abababababababababababababababababababababababababababababababab
